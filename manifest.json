{
  "manifest_version": 3,
  "name": "Firefox TTS",
  "version": "0.1.1",
  "description": "Local, CPU-only Piper read-aloud for Firefox. Development build.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "nativeMessaging"
  ],
  "action": {
    "default_title": "Toggle Firefox TTS reader",
    "default_icon": {
      "16": "src/icons/fox-tts-16.png",
      "32": "src/icons/fox-tts-32.png",
      "48": "src/icons/fox-tts-128.svg",
      "128": "src/icons/fox-tts-128.svg"
    }
  },
  "background": {
    "scripts": [
      "src/background/audio.js",
      "src/background/native.js",
      "src/background/action.js"
    ]
  },
  "options_ui": {
    "page": "src/options/pronunciation.html",
    "open_in_tab": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "firefox-tts@sguzman.dev",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+R"
      },
      "description": "Toggle Firefox TTS reader"
    }
  },
  "icons": {
    "16": "src/icons/fox-tts-16.png",
    "32": "src/icons/fox-tts-32.png",
    "48": "src/icons/fox-tts-128.svg",
    "128": "src/icons/fox-tts-128.svg"
  }
}
